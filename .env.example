# Database — from Supabase (Project Settings → Database → Connection string → URI)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Maps (add whichever provider you choose later — abstracted, not hard-coded)
NEXT_PUBLIC_MAPS_PROVIDER="mapbox"
NEXT_PUBLIC_MAPBOX_TOKEN=""
